{
    admin 127.0.0.1:2019
    storage file_system {
        root {$CADDY_DATA_DIR}
    }
}
{$SITE_DOMAIN} {
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    request_body {
        max_size 22MB
    }
    reverse_proxy 127.0.0.1:3000 {
        header_up X-Little-World-Client-IP {remote_host}
        flush_interval -1
    }
}
